{
  "manifest_version": 3,
  "name": "YouTube Music Together",
  "version": "0.1.2",
  "description": "Listen together through your own YouTube Music tabs. Private sessions for two.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://music.youtube.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "YouTube Music Together", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://music.youtube.com/*"], "js": ["adapter.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://music.youtube.com/*"], "js": ["content.js"], "world": "ISOLATED", "run_at": "document_idle" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}

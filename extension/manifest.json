{
  "manifest_version": 3,
  "name": "YT Music Jam",
  "version": "1.0.0",
  "description": "Listen to YouTube Music together, in sync, like Spotify Jam.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "YT Music Jam" },
  "content_scripts": [
    { "matches": ["https://music.youtube.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_start" }
  ]
}

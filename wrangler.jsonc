{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-music-together-relay",
  "main": "relay/worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "MusicRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MusicRoom"] }],
  "observability": { "enabled": false }
}
